@* FacturacionVERIFACTU.Web/Components/Pages/ResetPassword.razor *@
@page "/reset-password"
@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Json

<PageTitle>Nueva contraseña - FacturacionVERIFACTU</PageTitle>

<div class="login-container">
    <div class="login-card">

        <div class="login-logo">
            <i class="bi bi-shield-lock-fill" style="font-size: 2rem; color: #000;"></i>
            <h1>Nueva contraseña</h1>
            <p>Elige una contraseña segura para tu cuenta.</p>
        </div>

        @if (tokenInvalido)
        {
            <div class="alert" style="border-radius: 10px; border: none; background: #fff0f0; color: #e03e3e; padding: 16px; font-size: 14px; text-align: center;">
                <i class="bi bi-exclamation-triangle-fill" style="font-size: 1.4rem; display: block; margin-bottom: 8px;"></i>
                El enlace no es válido o ha expirado.
                <br />
                <small style="color: #6c757d; margin-top: 4px; display: block;">
                    Los enlaces tienen una validez de 1 hora.
                </small>
            </div>

            <a href="/forgot-password" class="btn-modern" style="display: block; text-align: center; text-decoration: none; margin-top: 16px;">
                Solicitar nuevo enlace
            </a>
        }
        else if (exito)
        {
            <div class="alert" style="border-radius: 10px; border: none; background: #f0fff5; color: #0f5132; padding: 16px; font-size: 14px; text-align: center;">
                <i class="bi bi-check-circle-fill" style="font-size: 1.4rem; display: block; margin-bottom: 8px;"></i>
                Contraseña restablecida correctamente.
            </div>

            <a href="/login" class="btn-modern" style="display: block; text-align: center; text-decoration: none; margin-top: 16px;">
                Iniciar sesión
            </a>
        }
        else
        {
            <EditForm Model="model" OnValidSubmit="CambiarAsync">
                <DataAnnotationsValidator />

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert" style="border-radius: 8px; border: none; background-color: #fff0f0; color: #e03e3e; font-size: 13px; padding: 12px; margin-bottom: 16px;">
                        <i class="bi bi-exclamation-circle-fill"></i> @errorMessage
                    </div>
                }

                <div class="notion-input-group">
                    <label class="notion-label">Nueva contraseña</label>
                    <InputText @bind-Value="model.NewPassword"
                               class="notion-input-modern"
                               type="password"
                               placeholder="Mínimo 8 caracteres"
                               autofocus />
                    <ValidationMessage For="() => model.NewPassword" class="notion-error" />
                    <PasswordStrengthBar Password="@model.NewPassword" />
                </div>

                <div class="notion-input-group" style="margin-top: 4px;">
                    <label class="notion-label">Confirmar contraseña</label>
                    <InputText @bind-Value="model.ConfirmPassword"
                               class="notion-input-modern"
                               type="password"
                               placeholder="Repite la contraseña" />
                    <ValidationMessage For="() => model.ConfirmPassword" class="notion-error" />
                </div>

                <button type="submit" class="btn-modern" disabled="@isLoading" style="margin-top: 8px;">
                    @if (isLoading)
                    {
                        <span class="spinner-border spinner-border-sm" role="status"></span>
                        <span class="ms-2">Guardando...</span>
                    }
                    else
                    {
                        <span>Guardar nueva contraseña</span>
                    }
                </button>
            </EditForm>
        }

    </div>
</div>

@code {
    private ResetModel model = new();
    private bool isLoading;
    private bool exito;
    private bool tokenInvalido;
    private string errorMessage = string.Empty;
    private string? token;

    [Inject] private HttpClient Http { get; set; } = null!;
    [Inject] private NavigationManager NavManager { get; set; } = null!;

    protected override void OnInitialized()
    {
        // Leer el token de la query string
        var uri = new Uri(NavManager.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        token = query["token"];

        if (string.IsNullOrWhiteSpace(token))
        {
            tokenInvalido = true;
        }
    }

    private async Task CambiarAsync()
    {
        if (string.IsNullOrWhiteSpace(token))
        {
            tokenInvalido = true;
            return;
        }

        isLoading = true;
        errorMessage = string.Empty;

        try
        {
            var response = await Http.PostAsJsonAsync("api/auth/reset-password", new
            {
                token,
                newPassword = model.NewPassword,
                confirmPassword = model.ConfirmPassword
            });

            if (response.IsSuccessStatusCode)
            {
                exito = true;
            }
            else
            {
                var content = await response.Content.ReadFromJsonAsync<ErrorResponse>();
                var msg = content?.Mensaje ?? "El enlace no es válido o ha expirado.";

                // Si el token no es válido mostramos la pantalla de token inválido
                if (response.StatusCode == System.Net.HttpStatusCode.BadRequest)
                {
                    tokenInvalido = true;
                }
                else
                {
                    errorMessage = msg;
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error de conexión: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private class ResetModel
    {
        [Required(ErrorMessage = "La contraseña es obligatoria")]
        [MinLength(8, ErrorMessage = "Mínimo 8 caracteres")]
        [RegularExpression(
            @"^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@$!%*?&])[A-Za-z\d@$!%*?&]{8,}$",
            ErrorMessage = "Debe contener mayúsculas, minúsculas, números y un carácter especial")]
        public string NewPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Confirma la contraseña")]
        [Compare(nameof(NewPassword), ErrorMessage = "Las contraseñas no coinciden")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }

    private class ErrorResponse
    {
        public string? Mensaje { get; set; }
        public string? Message { get; set; }
    }
}
