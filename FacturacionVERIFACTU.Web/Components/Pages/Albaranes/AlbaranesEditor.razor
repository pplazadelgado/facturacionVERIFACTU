    private static DateTime? ConvertirAUtc(DateTime? value)
    {
        if (!value.HasValue) return null;

        if (value.Value.TimeOfDay == TimeSpan.Zero) return DateTime.SpecifyKind(value.Value, DateTimeKind.Utc);

        var local = DateTime.SpecifyKind(value.Value, DateTimeKind.Local);
        return local.ToUniversalTime();
    }

    private static DateTime? ConvertirALocal(DateTime? value)
    {
        if(!value.HasValue) return null;

        DateTime fecha;
        if(value.Value.Kind == DateTimeKind.Utc)
        {
            fecha = value.Value.ToLocalTime();
        }
        else
        {
            fecha = value.Value;
        }

        return fecha.Date;
    }

