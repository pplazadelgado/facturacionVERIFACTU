@page "/cierre-ejercicio"
@using Microsoft.AspNetCore.Authorization
@using FacturacionVERIFACTU.Web.Models.DTOs
@inject IApiService ApiService
@inject ConfirmDialogService ConfirmDialog
@inject NavigationManager NavManager
@attribute [Authorize]



<PageTitle>Cierre de Ejercicio - FacturacionVERIFACTU</PageTitle>

<div class="notion-content">

    @* ── CABECERA ── *@
    <div class="notion-header">
        <div class="header-main">
            <span class="header-icon">
                <i class="bi bi-calendar-check"></i>
            </span>
            <div>
                <h1>Cierre de Ejercicio</h1>
                <p class="header-subtitle">Gestiona el cierre fiscal anual</p>
            </div>
        </div>
    </div>

    @* ── SELECTOR DE AÑO ── *@
    <div class="notion-toolbar" style="border-bottom: 1px solid #edeceb; margin-bottom: 30px;">
        <div class="toolbar-left" style="display: flex; align-items: center; gap: 12px;">
            <label class="form-label mb-0" style="font-weight: 500; color: #37352f;">
                <i class="bi bi-calendar3 me-1"></i> Ejercicio fiscal:
            </label>
            <select class="form-select form-select-sm"
                    style="width: 120px;"
                    @bind="anioSeleccionado"
                    @bind:after="CargarEstadisticasAsync">
                @for (int y = 2025; y >= 2020; y--)
                {
                    <option value="@y">@y</option>
                }
            </select>
        </div>
    </div>

    @* ── MENSAJE DE ERROR GLOBAL ── *@
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger d-flex align-items-center gap-2 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <span>@errorMessage</span>
            <button type="button" class="btn-close ms-auto" @onclick="() => errorMessage = null"></button>
        </div>
    }

    @* ── MENSAJE DE ÉXITO ── *@
    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success d-flex align-items-center gap-2 mb-4" role="alert">
            <i class="bi bi-check-circle-fill"></i>
            <span>@successMessage</span>
            <button type="button" class="btn-close ms-auto" @onclick="() => successMessage = null"></button>
        </div>
    }

    @* ── LOADING ── *@
    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-dark" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <p class="mt-2 text-muted">Cargando datos del ejercicio @anioSeleccionado...</p>
        </div>
    }
    else if (estadisticas != null)
    {
        @* ── CARD ESTADO DEL EJERCICIO ── *@
        <div class="row g-4 mb-4">

            @* Estado general *@
            <div class="col-12">
                <div class="card border-0 shadow-sm" style="border-radius: 12px;">
                    <div class="card-body p-4">

                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <h5 class="card-title mb-0" style="font-weight: 600; color: #37352f;">
                                <i class="bi bi-info-circle me-2"></i>Estado del Ejercicio @anioSeleccionado
                            </h5>

                            @* Badge estado *@
                            @if (cierreActual == null || cierreActual.EstaAbierto)
                            {
                                <span class="badge rounded-pill px-3 py-2"
                                      style="background: #e3f9e5; color: #1a7f37; font-size: 0.85rem; font-weight: 600;">
                                    <i class="bi bi-unlock-fill me-1"></i>ABIERTO
                                </span>
                            }
                            else
                            {
                                <span class="badge rounded-pill px-3 py-2"
                                      style="background: #ffeef0; color: #cf222e; font-size: 0.85rem; font-weight: 600;">
                                    <i class="bi bi-lock-fill me-1"></i>CERRADO
                                </span>
                            }
                        </div>

                        @* KPIs *@
                        <div class="row g-3 mb-3">
                            <div class="col-6 col-md-3">
                                <div class="kpi-box">
                                    <div class="kpi-label">Total Facturas</div>
                                    <div class="kpi-value">@estadisticas.TotalFacturas</div>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="kpi-box">
                                    <div class="kpi-label">Total Facturado</div>
                                    <div class="kpi-value">@estadisticas.TotalGeneral.ToString("N2") €</div>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="kpi-box">
                                    <div class="kpi-label">Base Imponible</div>
                                    <div class="kpi-value">@estadisticas.TotalBase.ToString("N2") €</div>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="kpi-box">
                                    <div class="kpi-label">Total IVA</div>
                                    <div class="kpi-value">@estadisticas.TotalIVA.ToString("N2") €</div>
                                </div>
                            </div>
                        </div>

                        @* Alerta VERIFACTU si hay pendientes *@
                        @if (estadisticas.FacturasPendientes > 0)
                        {
                            <div class="alert alert-warning d-flex align-items-center gap-2 mb-3"
                                 style="border-radius: 8px; border-left: 4px solid #f0a500;">
                                <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                                <div>
                                    <strong>@estadisticas.FacturasPendientes factura(s) pendiente(s) de envío a VERIFACTU</strong>
                                    <br />
                                    <small class="text-muted">
                                        Debes enviar todas las facturas a VERIFACTU antes de poder cerrar el ejercicio.
                                        <a href="/facturas" class="alert-link ms-1">Ir a Facturas →</a>
                                    </small>
                                </div>
                            </div>
                        }
                        else if (estadisticas.TotalFacturas > 0)
                        {
                            <div class="alert alert-success d-flex align-items-center gap-2 mb-3"
                                 style="border-radius: 8px; border-left: 4px solid #1a7f37;">
                                <i class="bi bi-check-circle-fill fs-5"></i>
                                <span>Todas las facturas han sido enviadas a VERIFACTU correctamente.</span>
                            </div>
                        }

                        @* Info del cierre si existe *@
                        @if (cierreActual != null && !cierreActual.EstaAbierto)
                        {
                            <div class="row g-2 mt-1">
                                <div class="col-12 col-md-6">
                                    <small class="text-muted">
                                        <i class="bi bi-calendar-event me-1"></i>
                                        Fecha de cierre: <strong>@cierreActual.FechaCierre?.ToString("dd/MM/yyyy HH:mm")</strong>
                                    </small>
                                </div>
                                <div class="col-12 col-md-6">
                                    <small class="text-muted">
                                        <i class="bi bi-person me-1"></i>
                                        Cerrado por: <strong>@cierreActual.NombreUsuario</strong>
                                    </small>
                                </div>
                                @if (!string.IsNullOrEmpty(cierreActual.HashFinal))
                                {
                                    <div class="col-12">
                                        <small class="text-muted">
                                            <i class="bi bi-shield-check me-1"></i>
                                            Hash final: <code style="font-size: 0.75rem;">@cierreActual.HashFinal</code>
                                        </small>
                                    </div>
                                }
                            </div>
                        }

                    </div>
                </div>
            </div>
        </div>

        @* ── RESUMEN TRIMESTRAL ── *@
        @if (estadisticas.ResumenTrimestral?.Any() == true)
        {
            <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px;">
                <div class="card-body p-4">
                    <h5 class="card-title mb-3" style="font-weight: 600; color: #37352f;">
                        <i class="bi bi-bar-chart me-2"></i>Resumen Trimestral
                    </h5>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0" style="font-size: 0.9rem;">
                            <thead style="background: #f7f6f3;">
                                <tr>
                                    <th>Trimestre</th>
                                    <th class="text-end">Facturas</th>
                                    <th class="text-end">Base Imponible</th>
                                    <th class="text-end">IVA</th>
                                    <th class="text-end">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var t in estadisticas.ResumenTrimestral)
                                {
                                    <tr>
                                        <td><span class="badge bg-secondary">T@(t.Trimestre)</span></td>
                                        <td class="text-end">@t.NumFacturas</td>
                                        <td class="text-end">@t.BaseImponible.ToString("N2") €</td>
                                        <td class="text-end">@t.TotalIva.ToString("N2") €</td>
                                        <td class="text-end fw-semibold">@t.Total.ToString("N2") €</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot style="background: #f7f6f3;">
                                <tr class="fw-bold">
                                    <td>TOTAL</td>
                                    <td class="text-end">@estadisticas.TotalFacturas</td>
                                    <td class="text-end">@estadisticas.TotalBase.ToString("N2") €</td>
                                    <td class="text-end">@estadisticas.TotalIVA.ToString("N2") €</td>
                                    <td class="text-end">@estadisticas.TotalGeneral.ToString("N2") €</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        }

        @* ── ACCIONES SEGÚN ESTADO ── *@
        <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px;">
            <div class="card-body p-4">
                <h5 class="card-title mb-4" style="font-weight: 600; color: #37352f;">
                    <i class="bi bi-gear me-2"></i>Acciones
                </h5>

                @if (cierreActual == null || cierreActual.EstaAbierto)
                {
                    @* Ejercicio ABIERTO: mostrar botón cerrar *@
                    <div class="d-flex align-items-center gap-3">
                        <button class="btn btn-dark px-4 py-2"
                                style="border-radius: 8px; font-weight: 500;"
                                disabled="@(!estadisticas.PuedeCerrar || isProcessing)"
                                @onclick="ConfirmarCierreEjercicio">
                            @if (isProcessing)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                <span>Procesando...</span>
                            }
                            else
                            {
                                <i class="bi bi-lock-fill me-2"></i>
                                <span>Cerrar Ejercicio @anioSeleccionado</span>
                            }
                        </button>

                        @if (!estadisticas.PuedeCerrar)
                        {
                            <small class="text-muted">
                                <i class="bi bi-info-circle me-1"></i>
                                @if (estadisticas.TotalFacturas == 0)
                                {
                                    <span>No hay facturas en este ejercicio.</span>
                                }
                                else
                                {
                                    <span>Hay @estadisticas.FacturasPendientes factura(s) pendiente(s) de envío a VERIFACTU.</span>
                                }
                            </small>
                        }
                    </div>
                }
                else
                {
                    @* Ejercicio CERRADO: mostrar descargas y reabrir *@
                    <div class="row g-3">

                        @* Descargas *@
                        <div class="col-12">
                            <p class="text-muted mb-3" style="font-size: 0.9rem;">
                                <i class="bi bi-file-earmark-check me-1"></i>
                                Documentos generados al cierre:
                            </p>
                            <div class="d-flex flex-wrap gap-3">
                                <button class="btn btn-outline-dark px-4 py-2"
                                        style="border-radius: 8px; font-weight: 500;"
                                        disabled="@(isDownloadingLibro)"
                                        @onclick="DescargarLibroFacturas">
                                    @if (isDownloadingLibro)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                        <span>Descargando...</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-file-earmark-spreadsheet me-2"></i>
                                        <span>Descargar Libro de Facturas</span>
                                    }
                                </button>

                                <button class="btn btn-outline-dark px-4 py-2"
                                        style="border-radius: 8px; font-weight: 500;"
                                        disabled="@(isDownloadingResumen)"
                                        @onclick="DescargarResumenIVA">
                                    @if (isDownloadingResumen)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                        <span>Descargando...</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-file-earmark-bar-graph me-2"></i>
                                        <span>Descargar Resumen IVA</span>
                                    }
                                </button>
                            </div>
                        </div>

                        <div class="col-12">
                            <hr style="border-color: #edeceb;" />
                        </div>

                        @* Reabrir *@
                        <div class="col-12">
                            <p class="text-muted mb-2" style="font-size: 0.9rem;">
                                <i class="bi bi-exclamation-triangle me-1 text-warning"></i>
                                Zona de operaciones críticas:
                            </p>
                            <button class="btn btn-outline-danger px-4 py-2"
                                    style="border-radius: 8px; font-weight: 500;"
                                    disabled="@isProcessing"
                                    @onclick="MostrarModalReabrir">
                                <i class="bi bi-unlock me-2"></i>
                                Reabrir Ejercicio @anioSeleccionado
                            </button>
                            <small class="d-block text-muted mt-2" style="font-size: 0.78rem;">
                                Reabrir el ejercicio desbloqueará todas las facturas y requerirá un motivo justificado.
                            </small>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    else if (!isLoading)
    {
        <div class="text-center py-5">
            <i class="bi bi-calendar-x" style="font-size: 3rem; color: #ccc;"></i>
            <h5 class="mt-3 text-muted">No hay datos para el ejercicio @anioSeleccionado</h5>
            <p class="text-muted">No se encontraron facturas en este período.</p>
        </div>
    }
</div>

@* ── MODAL REABRIR EJERCICIO ── *@
@if (mostrarModalReabrir)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.45);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="border-radius: 12px; border: none;">
                <div class="modal-header" style="border-bottom: 1px solid #edeceb;">
                    <h5 class="modal-title" style="font-weight: 600; color: #37352f;">
                        <i class="bi bi-unlock me-2 text-warning"></i>Reabrir Ejercicio @anioSeleccionado
                    </h5>
                    <button type="button" class="btn-close" @onclick="CerrarModalReabrir"
                            disabled="@isProcessing"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="alert alert-warning mb-3" style="border-radius: 8px; font-size: 0.9rem;">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        <strong>Atención:</strong> Esta acción desbloqueará todas las facturas del ejercicio
                        y permitirá su modificación. Esta operación queda registrada.
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            Motivo de la reapertura <span class="text-danger">*</span>
                        </label>
                        <textarea class="form-control @(motivoError ? "is-invalid" : "")"
                                  rows="3"
                                  placeholder="Indica el motivo por el que se reabre el ejercicio..."
                                  @bind="motivoReapertura"
                                  maxlength="500"></textarea>
                        @if (motivoError)
                        {
                            <div class="invalid-feedback">El motivo es obligatorio.</div>
                        }
                        <small class="text-muted">@(motivoReapertura?.Length ?? 0)/500 caracteres</small>
                    </div>
                    @if (!string.IsNullOrEmpty(errorReabrir))
                    {
                        <div class="alert alert-danger" style="border-radius: 8px; font-size: 0.88rem;">
                            <i class="bi bi-x-circle me-1"></i>@errorReabrir
                        </div>
                    }
                </div>
                <div class="modal-footer" style="border-top: 1px solid #edeceb;">
                    <button type="button" class="btn btn-outline-secondary"
                            @onclick="CerrarModalReabrir"
                            disabled="@isProcessing">
                        Cancelar
                    </button>
                    <button type="button" class="btn btn-danger px-4"
                            style="border-radius: 8px;"
                            disabled="@isProcessing"
                            @onclick="EjecutarReabrirEjercicio">
                        @if (isProcessing)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            <span>Reabriendo...</span>
                        }
                        else
                        {
                            <i class="bi bi-unlock me-2"></i>
                            <span>Confirmar Reapertura</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* ── ESTILOS ── *@
<style>
    .header-subtitle {
        color: #9b9a97;
        font-size: 0.88rem;
        margin: 0;
    }

    .kpi-box {
        background: #f7f6f3;
        border-radius: 10px;
        padding: 16px;
        text-align: center;
    }

    .kpi-label {
        font-size: 0.78rem;
        color: #9b9a97;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 6px;
        font-weight: 500;
    }

    .kpi-value {
        font-size: 1.35rem;
        font-weight: 700;
        color: #37352f;
    }

    .card {
        transition: box-shadow 0.2s;
    }

    .table th {
        font-weight: 600;
        font-size: 0.82rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: #9b9a97;
        border-bottom: 1px solid #edeceb;
    }

    .table td {
        border-color: #f0eeeb;
        vertical-align: middle;
    }

    .modal-content {
        box-shadow: 0 20px 60px rgba(0,0,0,0.2);
    }
</style>




@code {
    // ── Estado ──
    private int anioSeleccionado = DateTime.Now.Year;
    private bool isLoading = false;
    private bool isProcessing = false;
    private bool isDownloadingLibro = false;
    private bool isDownloadingResumen = false;

    private string? errorMessage;
    private string? successMessage;

    // ── Datos ──
    private EstadisticasCierreDto? estadisticas;
    private CierreEjercicioDto? cierreActual;

    // ── Modal Reabrir ──
    private bool mostrarModalReabrir = false;
    private string motivoReapertura = string.Empty;
    private bool motivoError = false;
    private string? errorReabrir;

    // ════════════════════════════════
    // LIFECYCLE
    // ════════════════════════════════
    protected override async Task OnInitializedAsync()
    {
        await CargarEstadisticasAsync();
    }

    // ════════════════════════════════
    // CARGA DE DATOS
    // ════════════════════════════════
    private async Task CargarEstadisticasAsync()
    {
        isLoading = true;
        errorMessage = null;
        successMessage = null;
        estadisticas = null;
        cierreActual = null;

        try
        {
            // 1. Cargar estadísticas del ejercicio
            estadisticas = await ApiService.GetAsync<EstadisticasCierreDto>(
                $"api/cierre-ejercicio/estadisticas/{anioSeleccionado}");

            if (estadisticas == null)
            {
                errorMessage = $"No se pudieron cargar los datos del ejercicio {anioSeleccionado}.";
                return;
            }

            // 2. Buscar si existe un cierre registrado para ese año
            var historial = await ApiService.GetAsync<PaginatedResponseDto<CierreEjercicioDto>>(
                $"api/cierre-ejercicio?ejercicio={anioSeleccionado}");

            cierreActual = historial?.Items?.FirstOrDefault();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar los datos: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    // ════════════════════════════════
    // CERRAR EJERCICIO
    // ════════════════════════════════
    private Task ConfirmarCierreEjercicio()
    {
        var options = new ConfirmDialogOptions(
            $"¿Cerrar el ejercicio {anioSeleccionado}?",
            $"Se bloquearán todas las facturas del ejercicio {anioSeleccionado} y se generarán los archivos de cierre. Esta acción es reversible pero queda registrada.",
            "Cerrar Ejercicio",
            "Cancelar"
        );

        ConfirmDialog.Show(options, async () =>
        {
            await EjecutarCierreEjercicio();
        });

        return Task.CompletedTask;
    }

    private async Task EjecutarCierreEjercicio()
    {
        isProcessing = true;
        errorMessage = null;

        try
        {
            var request = new { Ejercicio = anioSeleccionado };
            var resultado = await ApiService.PostAsync<object, CierreRealizadoDto>(
                $"api/cierre-ejercicio/cerrar", request);

            if (resultado == null)
            {
                throw new InvalidOperationException(
                    $"No se pudo cerrar el ejercicio {anioSeleccionado}. Comprueba que todas las facturas están enviadas a VERIFACTU.");
            }

            successMessage = $"✅ Ejercicio {anioSeleccionado} cerrado correctamente. Se han generado los archivos de cierre.";
            await CargarEstadisticasAsync();
        }
        finally
        {
            isProcessing = false;
        }
    }

    // ════════════════════════════════
    // DESCARGAS
    // ════════════════════════════════
    private async Task DescargarLibroFacturas()
    {
        if (cierreActual == null) return;

        isDownloadingLibro = true;
        errorMessage = null;

        try
        {
            // Navegar al endpoint de descarga (el navegador gestionará el fichero)
            NavManager.NavigateTo(
                $"api/cierre-ejercicio/descargar/libro/{cierreActual.Id}",
                forceLoad: true);
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al descargar el libro de facturas: {ex.Message}";
        }
        finally
        {
            isDownloadingLibro = false;
        }
    }

    private async Task DescargarResumenIVA()
    {
        if (cierreActual == null) return;

        isDownloadingResumen = true;
        errorMessage = null;

        try
        {
            NavManager.NavigateTo(
                $"api/cierre-ejercicio/descargar/resumen-iva/{cierreActual.Id}",
                forceLoad: true);
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al descargar el resumen IVA: {ex.Message}";
        }
        finally
        {
            isDownloadingResumen = false;
        }
    }

    // ════════════════════════════════
    // REABRIR EJERCICIO
    // ════════════════════════════════
    private void MostrarModalReabrir()
    {
        motivoReapertura = string.Empty;
        motivoError = false;
        errorReabrir = null;
        mostrarModalReabrir = true;
    }

    private void CerrarModalReabrir()
    {
        if (isProcessing) return;
        mostrarModalReabrir = false;
        motivoReapertura = string.Empty;
        motivoError = false;
        errorReabrir = null;
    }

    private async Task EjecutarReabrirEjercicio()
    {
        // Validar motivo
        motivoError = string.IsNullOrWhiteSpace(motivoReapertura);
        if (motivoError) return;

        if (cierreActual == null) return;

        isProcessing = true;
        errorReabrir = null;

        try
        {
            var request = new { CierreId = cierreActual.Id, Motivo = motivoReapertura.Trim() };

            var apiResult = await ApiService.PostAsyncDetailed(
                "api/cierre-ejercicio/reabrir", request);

            if (!apiResult.Success)
            {
                errorReabrir = string.IsNullOrWhiteSpace(apiResult.ErrorMessage)
                    ? "No se pudo reabrir el ejercicio. Inténtalo de nuevo."
                    : apiResult.ErrorMessage;
                return;
            }

            mostrarModalReabrir = false;
            successMessage = $"✅ El ejercicio {anioSeleccionado} ha sido reabierto correctamente.";
            await CargarEstadisticasAsync();
        }
        catch (Exception ex)
        {
            errorReabrir = ex.Message;
        }
        finally
        {
            isProcessing = false;
        }
    }

    // ════════════════════════════════
    // DTOs locales (modelos de respuesta de la API)
    // ════════════════════════════════

    private class EstadisticasCierreDto
    {
        public int Ejercicio { get; set; }
        public int TotalFacturas { get; set; }
        public int FacturasEnviadas { get; set; }
        public int FacturasPendientes { get; set; }
        public bool PuedeCerrar => FacturasPendientes == 0 && TotalFacturas > 0;
        public decimal TotalBase { get; set; }
        public decimal TotalIVA { get; set; }
        public decimal TotalRecargo { get; set; }
        public decimal TotalRetencion { get; set; }
        public decimal TotalGeneral { get; set; }
        public List<ResumenTrimestreDto> ResumenTrimestral { get; set; } = new();
    }

    private class ResumenTrimestreDto
    {
        public int Trimestre { get; set; }
        public int NumFacturas { get; set; }
        public decimal BaseImponible { get; set; }
        public decimal TotalIva { get; set; }
        public decimal Recargo { get; set; }
        public decimal Total { get; set; }
    }

    private class CierreEjercicioDto
    {
        public int Id { get; set; }
        public int Ejercicio { get; set; }
        public DateTime? FechaCierre { get; set; }
        public string? NombreUsuario { get; set; }
        public string? HashFinal { get; set; }
        public bool EstaAbierto { get; set; }
        public string? MotivoReapertura { get; set; }
        public DateTime? FechaReapertura { get; set; }
        public string? RutaLibroFacturas { get; set; }
        public string? RutaResumenIVA { get; set; }
    }

    private class CierreRealizadoDto
    {
        public int CierreId { get; set; }
        public int Ejercicio { get; set; }
        public string Mensaje { get; set; } = string.Empty;
    }

