@* FacturacionVERIFACTU.Web/Components/Pages/ForgotPassword.razor *@
@page "/forgot-password"
@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Json

<PageTitle>Recuperar contraseña - FacturacionVERIFACTU</PageTitle>

<div class="login-container">
    <div class="login-card">

        <div class="login-logo">
            <i class="bi bi-key-fill" style="font-size: 2rem; color: #000;"></i>
            <h1>Recuperar contraseña</h1>
            <p>Introduce tu email y te enviaremos un enlace para restablecer tu contraseña.</p>
        </div>

        @if (enviado)
        {
            <div class="alert alert-success" style="border-radius: 10px; border: none; background: #f0fff5; color: #0f5132; padding: 16px; font-size: 14px; text-align: center;">
                <i class="bi bi-check-circle-fill" style="font-size: 1.4rem; display: block; margin-bottom: 8px;"></i>
                Si el email está registrado, recibirás un mensaje con las instrucciones.
                <br />
                <small style="color: #6c757d; margin-top: 8px; display: block;">
                    Recuerda revisar la carpeta de spam.
                </small>
            </div>

            <a href="/login" class="btn-modern" style="display: block; text-align: center; text-decoration: none; margin-top: 16px;">
                Volver al inicio de sesión
            </a>
        }
        else
        {
            <EditForm Model="model" OnValidSubmit="EnviarAsync">
                <DataAnnotationsValidator />

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert" style="border-radius: 8px; border: none; background-color: #fff0f0; color: #e03e3e; font-size: 13px; padding: 12px; margin-bottom: 16px;">
                        <i class="bi bi-exclamation-circle-fill"></i> @errorMessage
                    </div>
                }

                <div class="notion-input-group">
                    <label class="notion-label">Email de tu cuenta</label>
                    <InputText @bind-Value="model.Email"
                               class="notion-input-modern"
                               type="email"
                               placeholder="nombre@empresa.com"
                               autofocus />
                    <ValidationMessage For="() => model.Email" class="notion-error" />
                </div>

                <button type="submit" class="btn-modern" disabled="@isLoading" style="margin-top: 8px;">
                    @if (isLoading)
                    {
                        <span class="spinner-border spinner-border-sm" role="status"></span>
                        <span class="ms-2">Enviando...</span>
                    }
                    else
                    {
                        <span>Enviar enlace</span>
                    }
                </button>
            </EditForm>

            <div style="text-align: center; margin-top: 20px; font-size: 13px; color: #787774; border-top: 1px solid #e9e9e7; padding-top: 16px;">
                <a href="/login" style="color: #000; font-weight: 600; text-decoration: none;">
                    <i class="bi bi-arrow-left"></i> Volver al inicio de sesión
                </a>
            </div>
        }

    </div>
</div>

@code {
    private ForgotModel model = new();
    private bool isLoading;
    private bool enviado;
    private string errorMessage = string.Empty;

    [Inject] private HttpClient Http { get; set; } = null!;

    private async Task EnviarAsync()
    {
        isLoading = true;
        errorMessage = string.Empty;

        try
        {
            var response = await Http.PostAsJsonAsync("api/auth/forgot-password",
                new { email = model.Email });

            // Siempre mostramos el mensaje genérico de éxito
            // (el backend devuelve 200 aunque el email no exista)
            if (response.IsSuccessStatusCode)
            {
                enviado = true;
            }
            else
            {
                errorMessage = "Error al procesar la solicitud. Inténtalo de nuevo.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error de conexión: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private class ForgotModel
    {
        [Required(ErrorMessage = "El email es obligatorio")]
        [EmailAddress(ErrorMessage = "Email inválido")]
        public string Email { get; set; } = string.Empty;
    }
}
