@inject NavigationManager NavManager
@code {
    protected override void OnInitialized()
    {
        // Si venimos de /admin, mandamos al login de admin.
        var relative = NavManager.ToBaseRelativePath(NavManager.Uri);
        if (relative.StartsWith("admin", StringComparison.OrdinalIgnoreCase))
        {
            var returnUrl = Uri.EscapeDataString(relative);
            NavManager.NavigateTo($"/admin/login?returnUrl={returnUrl}", forceLoad: true);
            return;
        }

        // Flujo estándar para el resto de la app.
        NavManager.NavigateTo("/login", forceLoad: true);
    }
}